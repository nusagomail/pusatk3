---
import '../styles/base.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { THEME_INIT_SCRIPT } from '../lib/theme';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search engines (internal pages). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script set:html={THEME_INIT_SCRIPT} is:inline />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#konten">
      Lewati ke konten
    </a>
    <Header current={Astro.url.pathname} />
    <main id="konten">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-bg);
    color: var(--color-ink);
    border-radius: var(--radius-button);
  }
  .skip-link:focus {
    top: 1rem;
  }
</style>
