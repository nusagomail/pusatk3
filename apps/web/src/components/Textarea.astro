---
/** Labelled multi-line input with the same look, hint and error handling as Input.astro. */
interface Props {
  label: string;
  name: string;
  id?: string;
  value?: string;
  required?: boolean;
  minlength?: number;
  maxlength?: number;
  rows?: number;
  hint?: string;
  error?: string;
}

const { label, name, id = `f-${name}`, value = '', hint, error, rows = 4, ...rest } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label for={id} class="field__label">
    {label}
  </label>
  <textarea
    class="field__control"
    id={id}
    name={name}
    rows={rows}
    aria-describedby={describedBy}
    aria-invalid={error ? 'true' : undefined}
    {...rest}
  >{value}</textarea>
  {hint && (
    <p class="field__hint" id={hintId}>
      {hint}
    </p>
  )}
  {error && (
    <p class="field__error" id={errorId}>
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: grid;
    gap: 0.375rem;
  }
  .field__label {
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    color: var(--color-ink-muted);
  }
  .field__control {
    min-height: calc(var(--touch-target) * 2.5);
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-input);
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
    resize: vertical;
  }
  .field__control[aria-invalid='true'] {
    border-color: var(--color-danger);
  }
  .field__hint,
  .field__error {
    margin: 0;
    font-size: var(--font-size-label);
  }
  .field__hint {
    color: var(--color-ink-subtle);
  }
  .field__error {
    color: var(--color-danger);
    font-weight: var(--font-weight-strong);
  }
</style>
