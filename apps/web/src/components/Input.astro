---
/** Labelled text input. The label is always present (visually hidden with `hideLabel`). */
interface Props {
  label: string;
  name: string;
  id?: string;
  type?: 'text' | 'search' | 'email' | 'tel' | 'date' | 'number';
  value?: string;
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  hint?: string;
  error?: string;
  hideLabel?: boolean;
}

const {
  label,
  name,
  id = `f-${name}`,
  type = 'text',
  hint,
  error,
  hideLabel = false,
  ...rest
} = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label for={id} class:list={['field__label', hideLabel && 'visually-hidden']}>
    {label}
  </label>
  <input
    class="field__control"
    id={id}
    name={name}
    type={type}
    aria-describedby={describedBy}
    aria-invalid={error ? 'true' : undefined}
    {...rest}
  />
  {hint && (
    <p class="field__hint" id={hintId}>
      {hint}
    </p>
  )}
  {error && (
    <p class="field__error" id={errorId}>
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: grid;
    gap: 0.375rem;
  }
  .field__label {
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
    color: var(--color-ink-muted);
  }
  .field__control {
    min-height: var(--touch-target);
    padding: 0 0.875rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-input);
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
  }
  .field__control::placeholder {
    color: var(--color-ink-subtle);
  }
  .field__control[aria-invalid='true'] {
    border-color: var(--color-danger);
  }
  .field__hint,
  .field__error {
    margin: 0;
    font-size: var(--font-size-label);
  }
  .field__hint {
    color: var(--color-ink-subtle);
  }
  .field__error {
    color: var(--color-danger);
    font-weight: var(--font-weight-strong);
  }
</style>
