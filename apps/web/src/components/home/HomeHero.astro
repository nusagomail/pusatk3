---
import { SEARCH_CITIES } from '../../data/home';
import Button from '../Button.astro';
import Input from '../Input.astro';
import Select from '../Select.astro';

const trust = [
  'Legalitas penyedia diverifikasi',
  'Sertifikasi Kemnaker & BNSP',
  'Hubungi penyedia tanpa perantara',
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <h1 id="hero-title">Temukan pelatihan & sertifikasi K3 terpercaya di seluruh Indonesia</h1>
    <p class="hero__lead">
      Bandingkan jadwal, lokasi, dan legalitas penyedia, lalu hubungi langsung. Gratis untuk
      peserta.
    </p>
    <form class="hero__search" action="/cari" method="get" role="search">
      <Input
        id="hero-q"
        label="Pelatihan"
        name="q"
        type="search"
        placeholder="Mis. Ahli K3 Umum, forklift"
      />
      <Select id="hero-city" label="Kota" name="city" options={SEARCH_CITIES} />
      <Button type="submit">Cari</Button>
    </form>
    <ul class="hero__trust">
      {trust.map((item) => (
        <li>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
            <path d="M8.3 13.6 4.7 10l-1.2 1.2 4.8 4.8 9-9-1.2-1.2-7.8 7.8Z" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    background: var(--color-hero);
    color: var(--color-on-hero-muted);
  }
  .hero__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3rem 1rem 2.5rem;
  }
  .hero h1 {
    max-width: 22ch;
    color: var(--color-on-hero);
  }
  .hero__lead {
    max-width: 52ch;
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
  }
  .hero__search {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-on-hero);
    font-weight: var(--font-weight-nav);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .hero__trust svg {
    color: var(--color-accent);
  }
  @media (min-width: 900px) {
    .hero__inner {
      padding: 4.5rem 1.5rem 4rem;
    }
    .hero__search {
      grid-template-columns: 2fr 1fr auto;
      align-items: end;
    }
  }
</style>
