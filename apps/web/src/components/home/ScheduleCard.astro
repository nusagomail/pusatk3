---
/** Schedule card. `sample` marks placeholder data that must never look real. */
import type { SampleSchedule } from '../../data/home';
import Pill from '../Pill.astro';

interface Props {
  schedule: SampleSchedule;
  sample?: boolean;
}

const { schedule, sample = false } = Astro.props;
---

<article class="schedule-card">
  <div class="schedule-card__date" aria-hidden="true">
    <span class="schedule-card__month">{schedule.month}</span>
    <span class="schedule-card__days">{schedule.days}</span>
  </div>
  <div class="schedule-card__body">
    <div class="schedule-card__pills">
      {sample && <span class="schedule-card__sample">Contoh</span>}
      <Pill tone="accent">{schedule.issuer}</Pill>
      <Pill>{schedule.mode}</Pill>
    </div>
    <h3 class="schedule-card__title">
      {sample && <span class="visually-hidden">Contoh: </span>}
      {schedule.title}
    </h3>
    <p class="schedule-card__meta">[Nama PJK3] · {schedule.place}</p>
    <p class="visually-hidden">
      Tanggal: {schedule.days} {schedule.monthName}
    </p>
    {sample ? (
      <a class="schedule-card__link" href={`/cari?q=${encodeURIComponent(schedule.title)}`}>
        Cari jadwal {schedule.title}
      </a>
    ) : (
      <a class="schedule-card__link" href="/cari">
        Lihat detail
      </a>
    )}
  </div>
</article>

<style>
  .schedule-card {
    display: flex;
    gap: 0.875rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }
  .schedule-card__date {
    display: grid;
    place-content: center;
    flex: 0 0 4rem;
    height: 4rem;
    border-radius: 12px;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    text-align: center;
    line-height: 1.1;
  }
  .schedule-card__month {
    font-size: 0.75rem;
    font-weight: var(--font-weight-strong);
  }
  .schedule-card__days {
    font-weight: var(--font-weight-display);
  }
  .schedule-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .schedule-card__sample {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-hero);
    color: var(--color-on-hero);
    /* Stays prominent in the dark theme, where hero ≈ page background. */
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
  }
  .schedule-card__title {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.0625rem;
  }
  .schedule-card__meta {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
  }
  .schedule-card__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-weight: var(--font-weight-strong);
  }
</style>
