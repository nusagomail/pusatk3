---
/**
 * "Kirim pertanyaan" (#28, ADR 0022): only rendered for providers that claimed their profile
 * (they read questions in the dashboard) and when a Turnstile site key is configured. Posts to
 * /kontak/pertanyaan; the API checks everything again. Consent text and its version come from
 * @pusatk3/shared (UU PDP). Needs the page to allow challenges.cloudflare.com in its CSP.
 */
import { LEAD_CONSENT_TEXT, LEAD_MESSAGE_MAX, TURNSTILE_LEAD_ACTION } from '@pusatk3/shared';
import Button from '../Button.astro';
import Input from '../Input.astro';

interface Props {
  scheduleId: string;
  /** Public Turnstile site key (TURNSTILE_SITE). */
  siteKey: string;
}

const { scheduleId, siteKey } = Astro.props;
---

<form class="question" method="post" action="/kontak/pertanyaan" aria-labelledby="question-title">
  <h3 id="question-title" class="question__title">
    Kirim pertanyaan
  </h3>
  <input type="hidden" name="scheduleId" value={scheduleId} />
  <Input label="Nama" name="name" required autocomplete="name" />
  <Input
    label="Nomor HP"
    name="phone"
    type="tel"
    autocomplete="tel"
    hint="Isi nomor HP atau email (salah satu)."
  />
  <Input label="Email" name="email" type="email" autocomplete="email" />
  <div class="field">
    <label for="f-message" class="field__label">
      Pertanyaan
    </label>
    <textarea
      id="f-message"
      class="field__control question__message"
      name="message"
      required
      minlength="10"
      maxlength={LEAD_MESSAGE_MAX}
      rows="4"
    ></textarea>
  </div>
  <label class="question__consent">
    <input type="checkbox" name="consent" required />
    <span>{LEAD_CONSENT_TEXT}</span>
  </label>
  <div
    class="cf-turnstile"
    data-sitekey={siteKey}
    data-action={TURNSTILE_LEAD_ACTION}
    data-language="id"
  ></div>
  <Button type="submit" block>
    Kirim pertanyaan
  </Button>
  <p class="question__note">
    Dilindungi Cloudflare Turnstile. Jangan kirim data sensitif selain yang diminta.
  </p>
</form>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .question {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .question__title {
    margin: 0;
    font-size: var(--font-size-h3, 1.125rem);
  }
  .question__message {
    min-height: 6rem;
    resize: vertical;
  }
  .question__consent {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: var(--font-size-label);
  }
  .question__consent input {
    margin-top: 0.25rem;
  }
  .question__note {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--font-size-label);
  }
</style>
