---
/** schema.org JSON-LD. "<" is escaped so data can never close the script element. */
interface Props {
  data: Record<string, unknown>;
}

const json = JSON.stringify({ '@context': 'https://schema.org', ...Astro.props.data }).replace(
  /</g,
  '\\u003c',
);
---

<script type="application/ld+json" is:inline set:html={json} />
