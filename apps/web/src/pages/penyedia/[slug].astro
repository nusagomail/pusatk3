---
/**
 * Provider profile (docs/ui-halaman.md, `Profil.dc.html`). Rendered on demand from the public API
 * (ADR 0019). The badge comes only from verification (rule 5). Reviews and claiming come later.
 */
import {
  normalizeWhatsAppNumber,
  providerParamsSchema,
  providerProfileSchema,
} from '@pusatk3/shared';
import Button from '../../components/Button.astro';
import LicenseList from '../../components/directory/LicenseList.astro';
import ResultCard from '../../components/directory/ResultCard.astro';
import JsonLd from '../../components/JsonLd.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { absoluteUrl } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiGet } from '../../lib/api';
import { PROVIDER_TYPE_LABELS } from '../../lib/format';
import { organizationJsonLd, profilePageStatus } from '../../lib/provider-page';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const valid = providerParamsSchema.safeParse({ slug }).success;
const result = valid
  ? await apiGet(`/providers/${encodeURIComponent(slug)}`, providerProfileSchema)
  : null;
const provider = result?.ok ? result.data : null;

const status = profilePageStatus(provider !== null, result && !result.ok ? result.status : null);
const unavailable = status === 503;
if (status !== 200) Astro.response.status = status;
if (unavailable) Astro.response.headers.set('Retry-After', '60');

const sample = provider?.isSample ?? false;
const whatsapp = provider?.contact.whatsapp
  ? normalizeWhatsAppNumber(provider.contact.whatsapp)
  : null;
const cities = provider ? [...new Set(provider.branches.map((b) => b.city.name))] : [];
const jsonLd = provider ? organizationJsonLd(provider) : null;
const typeLabel = provider ? PROVIDER_TYPE_LABELS[provider.type] : '';
---

{provider ? (
  <BaseLayout
    title={`${provider.name} — ${typeLabel} | PusatK3`}
    description={`${provider.name}: jadwal pelatihan K3, legalitas, dan cabang${cities.length ? ` di ${cities.join(', ')}` : ''}. Hubungi penyedia langsung.`}
    noindex={sample}
  >
    <div class="profile">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Beranda</a>
        <span aria-hidden="true">›</span>
        <a href="/cari">Cari pelatihan</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{provider.name}</span>
      </nav>
      {jsonLd && <JsonLd data={jsonLd} />}
      <JsonLd
        data={{
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Beranda', item: absoluteUrl('/') },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Cari pelatihan',
              item: absoluteUrl('/cari'),
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: provider.name,
              item: absoluteUrl(`/penyedia/${provider.slug}`),
            },
          ],
        }}
      />

      <header class="profile__head">
        {sample && <span class="profile__sample">Contoh — data fiktif</span>}
        <h1>{provider.name}</h1>
        <p class="profile__meta">
          <span>{typeLabel}</span>
          {cities.length > 0 && <span>· {cities.join(', ')}</span>}
          {provider.verified && <VerifiedBadge />}
        </p>
        {provider.description && <p class="profile__text">{provider.description}</p>}
        <div class="profile__actions">
          {whatsapp ? (
            <WhatsAppButton
              phone={whatsapp}
              message={`Halo ${provider.name}, saya menemukan profil Anda di PusatK3.`}
            >
              Chat via WhatsApp
            </WhatsAppButton>
          ) : (
            <p class="profile__muted">
              {sample
                ? 'Kontak tidak tersedia: ini data contoh fiktif.'
                : 'Penyedia belum mencantumkan WhatsApp.'}
            </p>
          )}
          {provider.contact.website && (
            <a
              class="profile__external"
              href={provider.contact.website}
              target="_blank"
              rel="nofollow noopener noreferrer"
            >
              Situs penyedia<span class="visually-hidden"> (membuka tab baru)</span>
            </a>
          )}
        </div>
        <p class="profile__muted profile__disclaimer">
          PusatK3 tidak memproses pendaftaran maupun pembayaran. Daftar dan bayar langsung ke
          penyedia.
        </p>
      </header>

      <nav class="profile__tabs" aria-label="Bagian profil">
        <a href="#jadwal">Jadwal ({provider.schedules.length})</a>
        <a href="#legalitas">Legalitas</a>
        <a href="#cabang">Cabang ({provider.branches.length})</a>
      </nav>

      <section id="jadwal" aria-labelledby="h-jadwal">
        <h2 id="h-jadwal">Jadwal mendatang</h2>
        {provider.schedules.length === 0 ? (
          <p>Belum ada jadwal mendatang.</p>
        ) : (
          <ul class="profile__list">
            {provider.schedules.map((schedule) => (
              <li>
                <ResultCard schedule={schedule} hideProvider />
              </li>
            ))}
          </ul>
        )}
      </section>

      <section id="legalitas" aria-labelledby="h-legal">
        <h2 id="h-legal">Legalitas</h2>
        <LicenseList licenses={provider.licenses} verified={provider.verified} />
      </section>

      <section id="cabang" aria-labelledby="h-cabang">
        <h2 id="h-cabang">Cabang</h2>
        {provider.branches.length === 0 ? (
          <p>Belum ada data cabang.</p>
        ) : (
          <ul class="profile__branches">
            {provider.branches.map((branch) => (
              <li>
                <strong>{branch.name}</strong>
                {branch.isMain && <span class="profile__muted"> · Kantor pusat</span>}
                <br />
                <span class="profile__muted">
                  {branch.address}, {branch.city.name}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <p class="profile__muted profile__claim">
        Anda pemilik atau pengelola {provider.name}? Fitur klaim dan koreksi profil segera tersedia.
      </p>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={
      unavailable
        ? 'Profil sedang tidak bisa dimuat — PusatK3'
        : 'Penyedia tidak ditemukan — PusatK3'
    }
    description={
      unavailable
        ? 'Profil penyedia sedang tidak bisa dimuat.'
        : 'Profil penyedia pelatihan ini tidak ditemukan atau sudah tidak tersedia.'
    }
    noindex
  >
    <div class="profile">
      {unavailable ? (
        <>
          <h1>Profil sedang tidak bisa dimuat</h1>
          <p role="alert">Coba beberapa saat lagi.</p>
        </>
      ) : (
        <>
          <h1>Penyedia tidak ditemukan</h1>
          <p>Profil ini tidak ada atau sudah tidak tersedia.</p>
        </>
      )}
      <Button href="/cari">Cari pelatihan</Button>
    </div>
  </BaseLayout>
)}

<style>
  .profile {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
  }
  .breadcrumb a,
  .profile__tabs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .profile__head {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 0;
  }
  .profile__sample {
    justify-self: start;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-hero);
    color: var(--color-on-hero);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-strong);
  }
  .profile__head h1 {
    margin: 0;
  }
  .profile__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--color-ink-muted);
  }
  .profile__text {
    white-space: pre-line;
  }
  .profile__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .profile__external {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-weight: var(--font-weight-strong);
  }
  .profile__muted {
    color: var(--color-ink-muted);
  }
  .profile__disclaimer {
    font-size: 0.875rem;
  }
  .profile__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1rem 0;
    border-bottom: 1px solid var(--color-border);
    font-weight: var(--font-weight-strong);
  }
  .profile__list,
  .profile__branches {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .profile__claim {
    margin-top: 2rem;
  }
</style>
