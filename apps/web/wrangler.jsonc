// Web Worker (Astro static assets). Top level = local build/preview. Deploys: staging by Cloudflare Workers Builds (ADR 0015), production by GitHub Actions (ADR 0012):
// build with CLOUDFLARE_ENV=<env> (only the production build is indexable).
// Wrangler does NOT inherit routes or vars into environments: declare them per env.
// See docs/adr/0011-lingkungan-cloudflare.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pusatk3-web",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // Unknown paths get the static 404 page (src/pages/404.astro) instead of an empty body.
  // SSR pages run the Worker first: with 404-page handling, browser navigations to paths that
  // are not static files would otherwise get 404.html without the Worker ever running (#24).
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/cari", "/jadwal/*", "/penyedia/*"],
  },
  // Invocation logs include full URLs (possible personal data): off unless stated per env.
  "observability": { "enabled": false },
  // SSR pages read the API (ADR 0019). Deployed: through a service binding (`API`, internal).
  // Local (`pnpm dev`, e2e): over HTTP to the local API dev server, because service bindings
  // between two local dev processes are unreliable (dev registry).
  "vars": { "API_ORIGIN": "http://127.0.0.1:8787" },
  "env": {
    "staging": {
      "name": "pusatk3-web-staging",
      // Owner decision 1A: staging on *.workers.dev until pusatk3.id is on Cloudflare.
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      "services": [{ "binding": "API", "service": "pusatk3-api-staging" }],
    },
    // Production API binding is added with the owner's approval when production is prepared
    // (CLAUDE.md: production bindings; checklist /siapkan-rilis).
    "production": {
      "name": "pusatk3-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false },
      // Needs the pusatk3.id zone on Cloudflare (docs/setup-cloudflare.md).
      "routes": [{ "pattern": "pusatk3.id/*", "zone_name": "pusatk3.id" }],
    },
  },
}
