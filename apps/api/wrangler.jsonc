// API Worker. Top level = local development (`pnpm dev`, tests). Deploys: staging by Cloudflare Workers Builds (ADR 0015), production by GitHub Actions (ADR 0012):
// staging = `--env staging`, production = `--env production` (owner approval).
// Wrangler does NOT inherit vars, d1_databases or routes into environments: declare them per env.
// See docs/adr/0011-lingkungan-cloudflare.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pusatk3-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Node.js APIs are on by default from 2026-08-04; we opt out so process.env/Buffer are
  // unavailable and config comes only from bindings (c.env). See ADR 0007.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  // Local D1 only (state in .wrangler/). Remote migrations: CI only.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pusatk3-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "vars": {
    "APP_VERSION": "dev",
  },
  "env": {
    "staging": {
      "name": "pusatk3-api-staging",
      // Owner decision 1A: staging on *.workers.dev until pusatk3.id is on Cloudflare.
      "workers_dev": true,
      "preview_urls": false,
      // Staging holds sample data only; logs help debugging. Production: off until Fase 3.
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pusatk3-staging",
          "database_id": "b8fcd041-9853-4ed2-81db-0901dba670b8",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      // Per-visitor limits (ADR 0022). Namespace ids are account-wide: 28xxx are reserved for
      // pusatk3 (shared account, ADR 0016).
      "ratelimits": [
        { "name": "RL_READ", "namespace_id": "28101", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_LEAD_FORM", "namespace_id": "28102", "simple": { "limit": 5, "period": 60 } },
        {
          "name": "RL_LEAD_CLICK",
          "namespace_id": "28103",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      // Daily lead retention at 02:17 WIB (ADR 0022).
      "triggers": { "crons": ["17 19 * * *"] },
      // Deploys override APP_VERSION with the commit SHA (--var APP_VERSION:<sha>).
      "vars": {
        "APP_VERSION": "staging",
      },
    },
    "production": {
      "name": "pusatk3-api-production",
      "workers_dev": false,
      "preview_urls": false,
      // Invocation logs contain full URLs (possible personal data): off until Fase 3.
      "observability": { "enabled": false },
      // Same origin as the web app: pusatk3.id/api/* (needs the pusatk3.id zone on Cloudflare).
      "routes": [{ "pattern": "pusatk3.id/api/*", "zone_name": "pusatk3.id" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pusatk3-production",
          // Created by the owner (docs/setup-cloudflare.md); CI refuses to deploy the placeholder.
          "database_id": "ISI-ID-D1-PRODUCTION-OLEH-PEMILIK",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      // Per-visitor limits (ADR 0022). Namespace ids are account-wide: 28xxx are reserved for
      // pusatk3 (shared account, ADR 0016).
      "ratelimits": [
        { "name": "RL_READ", "namespace_id": "28201", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_LEAD_FORM", "namespace_id": "28202", "simple": { "limit": 5, "period": 60 } },
        {
          "name": "RL_LEAD_CLICK",
          "namespace_id": "28203",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      // Daily lead retention at 02:17 WIB (ADR 0022).
      "triggers": { "crons": ["17 19 * * *"] },
      "vars": {
        "APP_VERSION": "production",
      },
    },
  },
}
