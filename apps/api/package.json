    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "wrangler": "4.165.0"
  }
}
