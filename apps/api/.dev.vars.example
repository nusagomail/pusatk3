# Local secrets for `pnpm dev` (copy to .dev.vars, which is git-ignored). NEVER commit real values.
# Non-secret settings live in wrangler.jsonc `vars` (APP_VERSION, ENVIRONMENT) and are not repeated here.
# Staging/production secrets are set by the owner (Cloudflare dashboard), never in files (ADR 0024).
#
# None are needed locally: email is only logged (ENVIRONMENT=local) and Turnstile uses
# Cloudflare's public test keys. Optional, to try real services locally:
# RESEND_API_KEY=        # email login codes
# GOOGLE_CLIENT_SECRET=  # "Masuk dengan Google"
# AUTH_SECRET=           # signs sessions
# TWO_FACTOR_KEY=        # encrypts 2FA (TOTP) secrets at rest
