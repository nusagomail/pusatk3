{
  "name": "pusatk3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm db:migrate:local && pnpm --filter @pusatk3/api exec wrangler d1 execute DB --local --file ../../e2e/fixtures-reset.sql && pnpm db:import:local && pnpm --filter @pusatk3/api exec wrangler d1 execute DB --local --file ../../e2e/fixtures.sql && turbo run build --filter=@pusatk3/web && playwright test",
    "db:generate": "pnpm --filter @pusatk3/db db:generate",
    "db:migrate:local": "pnpm --filter @pusatk3/api db:migrate:local",
    "db:seed:local": "pnpm --filter @pusatk3/api db:seed:local",
    "db:import:local": "pnpm --filter @pusatk3/api db:import:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@pusatk3/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
